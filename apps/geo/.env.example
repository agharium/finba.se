# Local development environment for Finba Geo API.
# Copy to .env and keep .env out of git:
#   cp .env.example .env
#
# Use the SAME GEO_INTERNAL_API_KEY value in apps/web/.env so Laravel is
# recognized as the internal client (X-API-Key → internal rate-limit tier).

PORT=8080
GEO_ENV=development
GEO_DATABASE_PATH=./data/geo.db
LOG_LEVEL=info

# Shared local-only placeholder — replace for your machine if you prefer,
# but keep Laravel (apps/web) and Geo in sync. Not for production.
GEO_INTERNAL_API_KEY=finba-local-dev-internal-key

# Optional trusted keys (comma-separated). Leave empty for local Finba-only use.
GEO_TRUSTED_API_KEYS=

# Keep false for direct localhost access (no Cloudflare in front).
GEO_TRUST_PROXY_HEADERS=false
